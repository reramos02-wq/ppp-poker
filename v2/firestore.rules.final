rules_version = '2';
// REGRAS FINAIS — publicar DEPOIS da virada, quando ninguém mais usa a versão antiga do app.
// O documento único da temporada passa a aceitar escrita só de admin (usado só no "voltar ao modelo antigo").
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    // admin = e-mail principal OU e-mail/uid na lista admins da temporada (sempre com e-mail verificado)
    // lista de admins: config/admins {list:[…]} (única, vale para todas as temporadas); enquanto não existir, usa a antiga em seasons/2026
    function adminList() {
      return exists(/databases/$(database)/documents/config/admins)
        ? get(/databases/$(database)/documents/config/admins).data.get('list', [])
        : get(/databases/$(database)/documents/seasons/2026).data.get('admins', []);
    }
    function isAdmin(season) {   // o parâmetro "season" é ignorado de propósito
      return verified() && (
        request.auth.token.email in ['reramos02@gmail.com'] ||
        request.auth.token.email in adminList() ||
        request.auth.uid in adminList()
      );
    }

    // ── estrutura antiga (documento único) ──
    match /seasons/{season} {
      allow read: if signedIn();
      allow write: if isAdmin(season);

      // ── estrutura nova ──
      match /stages/{stageId} {
        allow read: if signedIn();
        allow write: if isAdmin(season);
      }
      // custos da temporada (descontados do pote da premiação final): todos leem, só admin grava
      match /meta/{docId} {
        allow read: if signedIn();
        allow write: if isAdmin(season);
      }
      match /regs/{regId} {
        allow read: if signedIn();
        allow write: if isAdmin(season);
        // jogador: só a própria inscrição, e só em etapa não encerrada
        allow create, update: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && regId == request.resource.data.stageId + '__' + request.auth.uid
          && request.resource.data.keys().hasOnly(['stageId','uid','inscrito','late','ord','lord'])
          && get(/databases/$(database)/documents/seasons/$(season)/stages/$(request.resource.data.stageId)).data.get('allowInscriptions', true) != false
          && get(/databases/$(database)/documents/seasons/$(season)/stages/$(request.resource.data.stageId)).data.status != 'finished';
        allow delete: if signedIn()
          && regId.matches('.*__' + request.auth.uid)
          && get(/databases/$(database)/documents/seasons/$(season)/stages/$(regId.split('__')[0])).data.status != 'finished';
      }
    }

    match /claims/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin('2026'));
      allow delete: if isAdmin('2026');
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow write: if isAdmin('2026');
    }

    // prova do aceite da política: criado pelo próprio jogador com horário do servidor; ninguém edita nem apaga
    match /consents/{id} {
      allow read: if signedIn() && (id.matches(request.auth.uid + '__.*') || isAdmin('2026'));
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.version is string
        && id == request.auth.uid + '__' + request.resource.data.version
        && request.resource.data.keys().hasOnly(['uid','version','at','clientAt'])
        && request.resource.data.at == request.time;
      allow create: if isAdmin('2026')      // migração dos aceites que já estavam no cadastro dos jogadores
        && request.resource.data.keys().hasOnly(['uid','version','clientAt','source','migratedAt']);
      allow update, delete: if false;
    }

    match /config/admins {   // qualquer admin edita a lista (como antes); o resto de config/ é só do dono
      allow write: if isAdmin('2026');
    }
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if verified() && request.auth.token.email in ['reramos02@gmail.com'];
    }

    match /clocks/{clockId} {
      allow read: if signedIn();
      allow write: if isAdmin(clockId.split('_')[0]);
    }
  }
}
